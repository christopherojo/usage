{
  "manifest_version": 3,
  "name": "ChatGPT Usage Meter",
  "version": "0.1.0",
  "description": "See your ChatGPT / Codex 5-hour and weekly limits, and an estimated token cost for each query. Runs locally on chatgpt.com; no extra login.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup/popup.html", "default_title": "ChatGPT Usage" }
}
